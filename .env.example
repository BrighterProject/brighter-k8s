# =============================================================================
# BrighterProject — Kubernetes environment reference
# =============================================================================
# Kubernetes does NOT load this file. It is a checklist of every configurable
# env var and WHERE each one is set in the Helm charts:
#
#   [SECRET]   -> sealed secret, created/rotated with `scripts/seal.sh`, then
#                 `kubectl apply -f brighter-app/sealed-secrets/`. Fill the
#                 KEY= lines below and feed them to seal.sh.
#   [CONFIG]   -> non-secret Helm value in brighter-app/values*.yaml under the
#                 shown path (e.g. users-ms.config.logLevel). Edit there, not here.
#   [MANAGED]  -> generated at runtime (CloudNativePG) or derived from
#                 global.domain at chart render time — do not set by hand.
#
# App chart = `brighter` (brighter-app/), Observability chart = `brighter-obs`.
# =============================================================================


# ── [SECRET] users-ms-secrets  (seal.sh) ─────────────────────────────────────
# JWT signing secret — must be a strong random value in prod.
SECRET_KEY=
# Gmail App Password for the contact form sender.
SMTP_USER=
SMTP_PASSWORD=
# Cloudflare Turnstile secret (contact form anti-spam).
TURNSTILE_SECRET_KEY=

# ── [SECRET] properties-ms-secrets  (seal.sh) ────────────────────────────────
# Cloudflare R2 credentials for property image uploads.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── [SECRET] bookings-ms-secrets  (seal.sh) ──────────────────────────────────
# Fernet key encrypting GuestIdentity ID/passport fields at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOOKING_FIELD_ENCRYPTION_KEY=
# HS256 secret signing guest check-in links.
CHECKIN_TOKEN_SECRET=
# Shared secret gating /internal/* endpoints (used by the check-in CronJobs too).
INTERNAL_CRON_SECRET=

# ── [SECRET] payments-ms-secrets  (seal.sh) ──────────────────────────────────
# Stripe API + webhook secrets. Live keys require the webhook secret to be set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# ── [SECRET] notifications-ms-secrets  (seal.sh) ─────────────────────────────
RESEND_API_KEY=

# ── [SECRET] brighter-db-credentials  (manual kubectl create secret) ─────────
# CloudNativePG bootstrap role. `brighter-db-app` (the app DSN) is [MANAGED].
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

# ── [SECRET] brighter-obs release  (seal.sh) ─────────────────────────────────
# grafana-admin-secret
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# grafana-alerting-secrets (optional — Telegram alert routing)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GRAFANA_EXTERNAL_URL=


# =============================================================================
# [CONFIG] — non-secret values, set in brighter-app/values*.yaml (NOT here)
# =============================================================================
#
# ── Core / database ──────────────────────────────────────────────────────────
#   DB_URL                 [MANAGED] brighter-db-app secret (uri, asyncpg:// scheme)
#   REDIS_URL              <svc>.config.redisUrl   (redis://brighter-redis-master:6379/0)
#   global.domain          global.domain           (pochivka-na-moreto.bg)
#   global.publicScheme    global.publicScheme     ("" -> auto http/https)
#
# ── Inter-service URLs ───────────────────────────────────────────────────────
#   USERS_MS_URL / PROPERTIES_MS_URL / BOOKINGS_MS_URL /
#   PAYMENTS_MS_URL / NOTIFICATIONS_MS_URL   <svc>.config.<name>MsUrl
#
# ── Auth & security (users-ms) ───────────────────────────────────────────────
#   ACCESS_TOKEN_EXPIRE_MINUTES   users-ms.config.accessTokenExpireMinutes (120)
#   COOKIE_SECURE                 users-ms.config.cookieSecure             (false)
#   GOOGLE_CLIENT_ID              users-ms.config.googleClientId  (public OAuth id)
#   CONTACT_EMAIL                 users-ms.config.contactEmail
#   CONTACT_RATE_LIMIT            users-ms.config.contactRateLimit         (5)
#   CONTACT_RATE_WINDOW           users-ms.config.contactRateWindow        (3600)
#   SMTP_HOST                     users-ms.config.smtpHost   (smtp.gmail.com)
#   SMTP_PORT                     users-ms.config.smtpPort   (587)
#
# ── Email delivery (notifications-ms) ────────────────────────────────────────
#   DEFAULT_FROM_EMAIL            notifications-ms.config.fromEmail
#   EMAIL_TRANSPORT               (defaults to "resend"; "smtp" for mailpit/e2e)
#
# ── Payments (payments-ms · Stripe) ──────────────────────────────────────────
#   STRIPE_CHECKOUT_EXPIRES_MINUTES        payments-ms.config.stripeCheckoutExpiresMinutes (30)
#   STRIPE_PLATFORM_FEE_PERCENT            payments-ms.config.stripePlatformFeePercent     (10.0)
#   STRIPE_PROCESSING_FEE_PCT              payments-ms.config.stripeProcessingFeePct       (1.5)
#   STRIPE_PROCESSING_FEE_FIXED_EUR_CENTS  payments-ms.config.stripeProcessingFeeFixedEurCents (25)
#   STRIPE_CONNECT_API_VERSION             (app default 2026-05-27.dahlia)
#   STRIPE_*_URL / STRIPE_CONNECT_*_URI    [MANAGED] derived from global.domain
#
# ── Object storage (properties-ms · R2) ──────────────────────────────────────
#   R2_ACCOUNT_ID    properties-ms.config.r2AccountId
#   R2_BUCKET_NAME   properties-ms.config.r2BucketName
#   R2_PUBLIC_URL    properties-ms.config.r2PublicUrl
#
# ── Bookings & check-in (bookings-ms · BTR-15) ───────────────────────────────
#   CHECKIN_TOKEN_GRACE_DAYS    bookings-ms.config.checkinTokenGraceDays  (1)
#   CHECKIN_DISPATCH_LEAD_DAYS  bookings-ms.config.checkinDispatchLeadDays (2)
#   BOOKING_PURGE_WINDOW_DAYS   bookings-ms.config.bookingPurgeWindowDays  (14)
#   check-in CronJob schedules  bookings-ms.cron.dispatchSchedule / .purgeSchedule
#
# ── Channel calendar import (bookings-ms · BTR-41) ───────────────────────────
#   Not exposed in the chart — use app defaults. Notably
#   ENABLE_DEV_CALENDAR_CHANNEL defaults OFF, so the demo channel is never
#   available in k8s. Override CALENDAR_SYNC_* / CALENDAR_LOCAL_TZ only by
#   adding them to bookings-ms configmap if ever needed.
#
# ── Observability & logging (all backends) ───────────────────────────────────
#   LOG_LEVEL                    <svc>.config.logLevel  (INFO)
#   OTEL_EXPORTER_OTLP_ENDPOINT  <svc>.config.otelExporterOtlpEndpoint (http://otel-collector:4317)
#   OTEL_SDK_DISABLED            <svc>.config.otelSdkDisabled          (false)
#
# ── Frontend build args (Vite — baked into images at build time, via CI) ─────
#   VITE_API_URL / VITE_GOOGLE_CLIENT_ID / VITE_TURNSTILE_SITE_KEY  (brighter-frontend)
#   VITE_BASENAME (/admin) / VITE_GTM_ID                            (brighter-admin-panel)
#   VITE_ENABLE_DEV_CALENDAR_CHANNEL  -> leave unset in prod (demo channel off)
# =============================================================================
