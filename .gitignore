charts/*.tgz
# Helm dependency tarballs live under each chart's charts/ dir after the split
# into brighter-app/ and brighter-obs/. Fetched via `helm dependency update`.
**/charts/*.tgz

# Local secret material filled from .env.example (fed to scripts/seal.sh).
# k8s never reads .env directly — keep any filled copy out of git.
.env
.env.*
!.env.example
